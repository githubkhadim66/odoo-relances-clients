<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="relance_company_rule" model="ir.rule">
        <field name="name">Relance client : multi-sociétés</field>
        <field name="model_id" ref="model_account_relance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="relance_level_company_rule" model="ir.rule">
        <field name="name">Niveau de relance : multi-sociétés</field>
        <field name="model_id" ref="model_account_relance_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
