<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_relance_wizard_form" model="ir.ui.view">
        <field name="name">account.relance.wizard.form</field>
        <field name="model">account.relance.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer des relances">
                <group>
                    <field name="level_id"/>
                    <field name="date_relance"/>
                </group>
                <group>
                    <field name="note" placeholder="Note reprise sur chaque relance créée..."/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_relance_wizard" model="ir.actions.act_window">
        <field name="name">Générer des relances</field>
        <field name="res_model">account.relance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
